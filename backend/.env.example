# ==========================================
# KnowledgeHub AI Backend Configuration
# ==========================================

# Server Settings
API_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# CORS Allowed Origins (Comma separated or JSON array)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite)
DATABASE_URL=sqlite:///./data/knowledgehub.db

# Storage Directories
UPLOAD_DIRECTORY=./data/uploads
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=knowledgehub_documents

# Cohere API Settings (Keep secret - never expose to frontend)
COHERE_API_KEY=your_cohere_api_key_here
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_CHAT_MODEL=command-r-08-2024
COHERE_EMBED_BATCH_SIZE=96
